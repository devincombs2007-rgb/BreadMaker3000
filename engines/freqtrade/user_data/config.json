{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "breadmaker-freqtrade",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "spot",
  "margin_mode": "",
  "max_open_trades": 5,
  "stake_currency": "USD",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "timeframe": "1h",
  "cancel_open_orders_on_exit": true,
  "unfilledtimeout": {"entry": 10, "exit": 10, "exit_timeout_count": 0, "unit": "minutes"},
  "entry_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1,
                    "price_last_balance": 0.0, "check_depth_of_market": {"enabled": false, "bids_to_ask_delta": 1}},
  "exit_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1},
  "order_types": {"entry": "limit", "exit": "limit", "emergency_exit": "market", "force_entry": "market",
                  "force_exit": "market", "stoploss": "market", "stoploss_on_exchange": false},
  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": ["BTC/USD", "ETH/USD", "SOL/USD", "XRP/USD", "ADA/USD", "LTC/USD", "LINK/USD", "DOT/USD"],
    "pair_blacklist": [".*UP/.*", ".*DOWN/.*", ".*BULL/.*", ".*BEAR/.*"]
  },
  "pairlists": [{"method": "StaticPairList"}],
  "telegram": {"enabled": false, "token": "", "chat_id": ""},
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "set-via-env-FREQTRADE__API_SERVER__JWT_SECRET_KEY",
    "ws_token": "set-via-env-FREQTRADE__API_SERVER__WS_TOKEN",
    "CORS_origins": [],
    "username": "breadmaker",
    "password": "set-via-env-FREQTRADE__API_SERVER__PASSWORD"
  },
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {"process_throttle_secs": 5, "heartbeat_interval": 60},
  "db_url": "sqlite:////freqtrade/user_data/tradesv3.dryrun.sqlite",
  "strategy": "BreadTrendV1",
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather"
}
