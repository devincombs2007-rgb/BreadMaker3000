{
  "bot_name": "breadmaker-freqai",
  "strategy": "BreadFreqAIV1",
  "db_url": "sqlite:////freqtrade/user_data/tradesv3.freqai.dryrun.sqlite",
  "max_open_trades": 3,
  "api_server": {"listen_port": 8081},
  "freqai": {
    "enabled": true,
    "identifier": "bread-lgbm-v1",
    "purge_old_models": 4,
    "train_period_days": 60,
    "backtest_period_days": 7,
    "live_retrain_hours": 24,
    "expiration_hours": 48,
    "activate_tensorboard": false,
    "fit_live_predictions_candles": 300,
    "feature_parameters": {
      "include_timeframes": ["1h", "4h"],
      "include_corr_pairlist": ["BTC/USD"],
      "label_period_candles": 12,
      "include_shifted_candles": 2,
      "indicator_periods_candles": [12, 24, 72],
      "DI_threshold": 0.9,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": true,
      "plot_feature_importances": 0
    },
    "data_split_parameters": {"test_size": 0.25, "shuffle": false},
    "model_training_parameters": {"n_estimators": 300, "learning_rate": 0.03, "num_leaves": 31,
                                  "min_child_samples": 50, "subsample": 0.8, "colsample_bytree": 0.8,
                                  "n_jobs": 2, "verbosity": -1}
  }
}
