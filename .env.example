# BreadMaker3000 server settings. deploy/install.sh creates .env with random values.
# NEVER commit .env. Values in single quotes are not interpolated by Docker Compose.
#
# The dashboard password and Alpaca PAPER keys are entered in the dashboard itself
# (first visit + Settings) and stored on the server's private data volume.

ALPACA_PAPER=true

# Freqtrade REST API (private Docker network only)
FREQTRADE__API_SERVER__PASSWORD='change-me'
FREQTRADE__API_SERVER__JWT_SECRET_KEY='change-me'
FREQTRADE__API_SERVER__WS_TOKEN='change-me'

# true when served over HTTPS (Tailscale serve). false only for local testing.
DASHBOARD_SECURE_COOKIES=true

# Optional overrides (normally leave unset):
# DASHBOARD_PASSWORD_HASH=''     # scrypt hash from: breadmaker hash-password
# ALPACA_API_KEY=''              # paper key (PK...) - prefer dashboard Settings
# ALPACA_API_SECRET=''
