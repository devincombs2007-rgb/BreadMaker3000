# BreadMaker3000 server settings. deploy/install.sh creates .env. NEVER commit .env.
# The dashboard password is chosen in the dashboard on first visit.

# true when served over HTTPS (Tailscale serve). false only for local testing.
DASHBOARD_SECURE_COOKIES=true

# Kalshi API access stays OFF unless BOTH config/breadmaker.yaml kalshi.api_enabled is true AND
# this line is uncommented. Only uncomment after Kalshi has given written authorization for this use
# and only on a private server/repository (Kalshi Developer Agreement v1.1 s3, s3.1, s4.1).
# KALSHI_ACCESS_AUTHORIZED=written-authorization-on-file
